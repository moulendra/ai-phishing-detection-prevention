# Environment Configuration for Phishing Detection System

# Secret Key for Flask (change in production)
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///phishing_detection.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/phishing_detection

# Logging Configuration
LOG_LEVEL=INFO

# API Configuration
API_RATE_LIMIT=100 per hour
MAX_CONTENT_LENGTH=10485760

# Security Configuration
ENABLE_SSL=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Model Configuration
MODEL_PATH=backend/models/phishing_model.pkl
VECTORIZER_PATH=backend/models/vectorizer.pkl
SCALER_PATH=backend/models/scaler.pkl

# Feature Flags
ENABLE_AUTO_BLOCK=true
BLOCK_THRESHOLD=0.7